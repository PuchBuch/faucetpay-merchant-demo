# Copy to .env (never commit .env) and fill in.

# Your FaucetPay username (the merchant who receives the coins)
FAUCETPAY_MERCHANT_USERNAME=

# Public URL of this shop; FaucetPay sends callbacks to PUBLIC_BASE_URL/faucetpay/callback
PUBLIC_BASE_URL=http://127.0.0.1:5000

# Flask secret; generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# SQLite database file
SHOP_DB=shop.db

# Password for /admin/orders (Basic-Auth, any username). Empty = admin page disabled (404).
ADMIN_PASSWORD=
